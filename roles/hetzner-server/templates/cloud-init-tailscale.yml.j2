#cloud-config
# Joins the tailnet on first boot. In private network mode nothing but the
# tailnet can reach this server, so Ansible depends on this having run.
# Mirrors roles/tailscale/templates/tailscale-up.sh.j2, which does the same for
# servers that already exist.
{% set key = tailscale_boot_keys[server_name] %}
write_files:
  # Joining creates tailscale0, which starts the socket-activated
  # cloud-init-hotplugd. The next apt install runs needrestart, which restarts
  # that service directly — and a directly started hotplugd blocks forever
  # reading its socket, taking apt (and the Ansible run) down with it.
  # Mirrors roles/tailscale/tasks/main.yml.
  - path: /etc/needrestart/conf.d/cloud-init-hotplugd.conf
    content: |
      $nrconf{override_rc}{qr(^cloud-init-hotplugd)} = 0;
runcmd:
  - |
    set -e
    curl -fsSL https://tailscale.com/install.sh | sh
    tailscale up \
      --auth-key={{ key | quote }} \
      --advertise-tags='{{ tailscale_tags | default(["tag:server"]) | join(",") }}' \
      --hostname='{{ server_name }}'
